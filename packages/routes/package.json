{
  "name": "@ischemist/routes",
  "version": "0.0.1",
  "description": "typescript route projection primitives for retrocast-compatible retrosynthesis routes",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./projection": {
      "types": "./dist/projection.d.ts",
      "import": "./dist/projection.js"
    },
    "./visualization": {
      "types": "./dist/visualization.d.ts",
      "import": "./dist/visualization.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.3"
  }
}
