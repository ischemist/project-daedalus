{
  "name": "@ischemist/retrocast-io",
  "version": "0.1.0",
  "description": "node-only retrocast workspace artifact discovery and audit bundle loaders",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @ischemist/routes build && pnpm run build && node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ischemist/project-daedalus.git",
    "directory": "packages/retrocast-io"
  },
  "bugs": {
    "url": "https://github.com/ischemist/project-daedalus/issues"
  },
  "homepage": "https://github.com/ischemist/project-daedalus/tree/master/packages/retrocast-io#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ischemist/routes": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
