{
  "name": "project-daedalus",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm --filter @ischemist/web dev",
    "build": "pnpm --filter @ischemist/web build",
    "lint": "oxlint --type-aware --quiet apps/web",
    "check-types": "tsgo --project apps/web/tsconfig.json --noEmit",
    "typecheck": "pnpm check-types",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "lefthook install",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @ischemist/web prisma:generate",
    "db:migrate": "pnpm --filter @ischemist/web prisma:migrate:dev",
    "db:deploy": "pnpm --filter @ischemist/web prisma:migrate:deploy",
    "db:studio": "pnpm --filter @ischemist/web prisma:studio"
  },
  "devDependencies": {
    "@typescript/native-preview": "beta",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.21.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp"
    ]
  }
}
