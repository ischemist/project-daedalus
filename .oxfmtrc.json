{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "ignorePatterns": [
    ".next/**",
    ".turbo/**",
    "build/**",
    "coverage/**",
    "dist/**",
    "out/**",
    "apps/web/src/generated/prisma/**"
  ],
  "printWidth": 80,
  "semi": false,
  "singleQuote": false,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "functions": ["cn", "cva"],
    "stylesheet": "./apps/web/src/app/globals.css"
  },
  "tabWidth": 2,
  "trailingComma": "es5"
}
