{
  "languages": {
    "TypeScript": {
      "prettier": {
        "allowed": false
      },
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": ["exec", "oxfmt", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on",
      "tab_size": 2,
      "hard_tabs": false,
      "preferred_line_length": 80,
      "soft_wrap": "preferred_line_length"
    },
